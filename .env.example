# LLM APIs
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# DB
DATABASE_URL=sqlite+aiosqlite:///data/local.db

# Feature flags
SKIP_DEEP_RESEARCH=false
SKIP_INTENSIVE_SEARCH=false

# Fetcher backend (legacy = httpx+playwright, scrapling = Scrapling StealthyFetcher)
FETCHER_BACKEND=scrapling

# Alerts
ALERT_COST_DAILY_USD=20

# Auth (bcrypt hashes, generar con streamlit-authenticator en Phase 5)
AUTH_USERS_FILE=config/users.yaml

# Logging
LOG_LEVEL=INFO
